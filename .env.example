# ============================================================================
# Relative Pointing — environment configuration
# ============================================================================
# Copy this file to `.env` and fill in the values you need.
#
#   Local dev:        only the VITE_API_URL section matters.
#   EC2 + Docker:     fill in everything below.
#
# `docker compose` automatically loads `.env` from the project root, so any
# variable here is available both for compose-time interpolation and as a
# runtime env var passed into the container.
# ============================================================================


# ----------------------------------------------------------------------------
# App runtime (passed into the container by docker-compose.yml)
# ----------------------------------------------------------------------------

# Port the host exposes. Set to 80 to serve HTTP directly without a proxy,
# or leave at 5001 if you'll put Caddy/nginx in front for TLS.
HOST_PORT=5001

# Port the Node server listens on inside the container.
APP_PORT=5001

# SQLite file location inside the container. Must live under /data so the
# named volume picks it up and the DB survives container restarts.
DB_PATH=/data/app.db

# Offline badge timing (seconds). Default matches server/db.js.
OFFLINE_THRESHOLD_S=300


# ----------------------------------------------------------------------------
# Client build (Vite)
# ----------------------------------------------------------------------------

# In production the server serves /api alongside the static client, so a
# relative path is correct. Override only if you host the API on a different
# origin (e.g. api.example.com).
VITE_API_URL=/api


# ----------------------------------------------------------------------------
# EC2 host — required for remote deploy
# ----------------------------------------------------------------------------

# Public IPv4 or public DNS of the EC2 instance.
# Find under: AWS Console → EC2 → Instances → your instance → Public IPv4.
EC2_HOST=

# SSH username. 'ubuntu' for Ubuntu AMIs, 'ec2-user' for Amazon Linux 2023.
EC2_USER=ubuntu

# Local path to the .pem private key downloaded from AWS.
EC2_KEY_PATH=~/.ssh/your-ec2-key.pem

# Domain name pointing at EC2_HOST via a Route 53 / DNS A-record.
# Required if you terminate TLS with Caddy or certbot.
EC2_DOMAIN=

# Region where the instance lives. Used by aws-cli / ECR commands.
AWS_REGION=us-east-2

# Project root on the EC2 box — the directory that will hold the compose
# file, the .env, and the Dockerfile after `scp`/`git clone`.
EC2_APP_DIR=/srv/relative-pointing


# ----------------------------------------------------------------------------
# Optional — pull a prebuilt image from ECR instead of building on the box.
# Uncomment and run `docker compose pull && docker compose up -d`.
# ----------------------------------------------------------------------------

# IMAGE=<account-id>.dkr.ecr.<region>.amazonaws.com/relative-pointing:latest


# ----------------------------------------------------------------------------
# Optional — Let's Encrypt for the reverse proxy (Caddy / certbot).
# Only used once you add a TLS-terminating sidecar to the compose file.
# ----------------------------------------------------------------------------

# CERTBOT_EMAIL=ops@your-domain.com
